# Variables de entorno del portal de bugs.
# Copia a .env.local para desarrollo. Los secretos reales viven en Vercel/Supabase, nunca en el repo.

# --- Supabase ---
# URL y claves del proyecto (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Clave de servicio (solo en servidor: subida de adjuntos, escritura en la tabla reportes).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- App ---
# URL pública del portal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dominios de email permitidos (separados por coma). SOLO servidor: no se expone al navegador
# para no revelar qué correos valen. El acceso es nombre + correo, validando el dominio
# en /api/identify (no se envía nada al correo).
ALLOWED_EMAIL_DOMAINS=edibschool.com,nuclio.school,indexmediamarketing.com

# --- API de reportes desde otras apps (issue #32) ---
# Secreto compartido con las apps que reportan de servidor a servidor (ej. Metriks).
# Se manda en la cabecera `x-bug-portal-secret` de /api/report y /api/upload-url y habilita
# la vía de confianza: el `reporter` del body se da por verificado (aunque el dominio del
# correo se sigue validando). Sin esta variable la vía de confianza no existe (401) y el
# portal web funciona igual. Cadena aleatoria larga, se provisiona en Vercel.
BUG_PORTAL_SECRET=<cadena-aleatoria>

# --- GitHub App ---
# Datos de la GitHub App del portal (crea la App en la org y rellena esto).
GITHUB_APP_ID=<app-id>
GITHUB_APP_INSTALLATION_ID=<installation-id>
# Clave privada en PEM. En Vercel se guarda como variable multilinea o en base64.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Org de GitHub donde viven los repos de producto.
GITHUB_ORG=EDIBS-SCHOOL
# Topic que marca un repo como producto reportable.
GITHUB_PRODUCT_TOPIC=bug-portal
# Secreto del webhook de la GitHub App (para validar la firma de los eventos).
GITHUB_WEBHOOK_SECRET=<webhook-secret>
# --- Panel de administración (login con GitHub OAuth de la propia GitHub App) ---
# Client ID de la GitHub App (Settings -> About) y un client secret generado en la App.
GITHUB_APP_CLIENT_ID=<Iv23...>
GITHUB_APP_CLIENT_SECRET=<client-secret-de-la-app>
# Secreto para firmar la cookie de sesión del panel (cadena aleatoria larga).
PANEL_SESSION_SECRET=<cadena-aleatoria>

# --- IA (opcional: análisis automático del bug, issue #9) ---
# Si está presente, al crear el issue se añade un comentario estructurado con Claude.
# Sin esta clave, el análisis simplemente no se hace (el resto funciona igual).
ANTHROPIC_API_KEY=<sk-ant-...>
# Modelo a usar (por defecto claude-opus-4-8; se puede bajar a claude-sonnet-5 para abaratar).
ANTHROPIC_MODEL=claude-opus-4-8

# --- Slack ---
# Token de bot (xoxb-...) con chat:write. Canal donde se avisa.
SLACK_BOT_TOKEN=<xoxb-...>
SLACK_BUG_CHANNEL=#bug
# Signing Secret de la Slack app (Basic Information -> App Credentials).
# Necesario para verificar los clics de botones interactivos (botón "Me la quedo" de sugerencias).
SLACK_SIGNING_SECRET=<signing-secret>
# Team ID de Slack (para el enlace directo al DM del reporter desde el panel). Público.
NEXT_PUBLIC_SLACK_TEAM_ID=<TXXXXXXX>
# IDs de Slack de los devs a mencionar (mapa producto -> devs se resuelve en código).
SLACK_DEV_ANTONIO=U0BAU7N7ZSA
SLACK_DEV_ANGEL=U0BC1RE5NUT
